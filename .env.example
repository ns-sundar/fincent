# Copy this file to `.env` and fill in real values.
# OpenAI key is required for any non-mock run.
OPENAI_API_KEY=

# Optional overrides (any of the YAML keys may be overridden using
# the FINCENT__ prefix and double-underscore nesting).
# FINCENT__LLM__MODEL=gpt-4o-mini
# FINCENT__SERVER__PORT=8000
# FINCENT__UI__API_BASE_URL=http://localhost:8000
#
# Checkpoint DB (default /data/checkpoints.sqlite). HF Spaces mounts /data.
# FINCENT__CHECKPOINTER__PATH=/data/checkpoints.sqlite
