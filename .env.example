# Copy this file to `.env` and fill in real values.
# OpenAI key is required for any non-mock run.
OPENAI_API_KEY=

# Optional overrides (any of the YAML keys may be overridden using
# the FINCENT__ prefix and double-underscore nesting).
# FINCENT__LLM__MODEL=gpt-4o-mini
# FINCENT__SERVER__PORT=8000
# Startup health wait (seconds); must cover RAG ingestion in lifespan (HF Spaces).
# FINCENT__SERVER__STARTUP_HEALTH_WAIT_SECONDS=300
# FINCENT__UI__API_BASE_URL=http://localhost:8000
#
# Checkpoint DB (default /data/checkpoints.sqlite). HF Spaces mounts /data.
# FINCENT__CHECKPOINTER__PATH=/data/checkpoints.sqlite
#
# RAG (Q&A agent) — FAISS vector store lives alongside the checkpoint DB
# on the host /data mount. Ingestion is idempotent: existing index is reused.
# FINCENT__RAG__ENABLED=true
# FINCENT__RAG__VECTOR_DB_PATH=/data/vector_db
# FINCENT__RAG__EMBEDDING_MODEL=text-embedding-3-small
# FINCENT__RAG__CHUNK_SIZE=1000
# FINCENT__RAG__CHUNK_OVERLAP=200
# FINCENT__RAG__TOP_K=5
#
# MMR re-ranking at query time (diversify top-k).
# FINCENT__RAG__USE_MMR=true
# FINCENT__RAG__MMR_FETCH_K=20
# FINCENT__RAG__MMR_LAMBDA=0.5
#
# MCP server sidecar (exposes the FAISS vector_db as a tool).
# FINCENT__RAG__MCP_SERVER__ENABLED=false
# FINCENT__RAG__MCP_SERVER__TRANSPORT=stdio   # or "streamable-http"
# FINCENT__RAG__MCP_SERVER__HOST=127.0.0.1
# FINCENT__RAG__MCP_SERVER__PORT=8765
# FINCENT__RAG__MCP_SERVER__TOOL_NAME=rag_search
