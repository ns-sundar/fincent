# Copy this file to `.env` and fill in real values.
# OpenAI key is required for any non-mock run.
OPENAI_API_KEY=

# Optional overrides (any of the YAML keys may be overridden using
# the FINCENT__ prefix and double-underscore nesting).
# FINCENT__LLM__MODEL=gpt-5.4-mini
# FINCENT__SERVER__PORT=8000
# Startup health wait (seconds); must cover RAG ingestion in lifespan (HF Spaces).
# FINCENT__SERVER__STARTUP_HEALTH_WAIT_SECONDS=900
# FINCENT__UI__API_BASE_URL=http://localhost:8000
#
# Checkpoint DB (default /data/checkpoints.sqlite). HF Spaces mounts /data.
# FINCENT__CHECKPOINTER__PATH=/data/checkpoints.sqlite
#
# RAG (Q&A agent) — FAISS vector store lives alongside the checkpoint DB
# on the host /data mount. Ingestion is idempotent: existing index is reused.
# FINCENT__RAG__ENABLED=true
# FINCENT__RAG__VECTOR_DB_PATH=/data/vector_db
# FINCENT__RAG__EMBEDDING_MODEL=text-embedding-3-small
# FINCENT__RAG__CHUNK_SIZE=1000
# FINCENT__RAG__CHUNK_OVERLAP=200
# FINCENT__RAG__TOP_K=5
#
# MMR re-ranking at query time (diversify top-k).
# FINCENT__RAG__USE_MMR=true
# FINCENT__RAG__MMR_FETCH_K=20
# FINCENT__RAG__MMR_LAMBDA=0.5
#
# MCP server sidecar (exposes the FAISS vector_db as a tool).
# FINCENT__RAG__MCP_SERVER__ENABLED=false
# FINCENT__RAG__MCP_SERVER__TRANSPORT=stdio   # or "streamable-http"
# FINCENT__RAG__MCP_SERVER__HOST=127.0.0.1
# FINCENT__RAG__MCP_SERVER__PORT=8765
# FINCENT__RAG__MCP_SERVER__TOOL_NAME=rag_search
#
# Portfolio agent tools (MCP). The Portfolio agent loads tools from
# two MCP servers launched in stdio mode: the OpenBB MCP server
# (real-world financial data via yfinance etc.) and the Fincent RAG
# MCP server (same FAISS vector_db the Q&A agent uses). Set enabled
# to false to fall back to the legacy direct-LLM answer path.
# FINCENT__PORTFOLIO__TOOLS__OPENBB__ENABLED=true
# FINCENT__PORTFOLIO__TOOLS__OPENBB__COMMAND=openbb-mcp
# FINCENT__PORTFOLIO__TOOLS__RAG__ENABLED=true
# FINCENT__PORTFOLIO__TOOLS__RAG__COMMAND=python
#
# Provider API keys for OpenBB live in ``~/.openbb_platform/user_settings.json``;
# the free providers (yfinance, SEC, FRED, ...) work with no key.
#
# Market Research agent (MCP). The loader reads these from the environment.
# ``FMP_ACCESS_TOKEN`` is what the ``fmp-mcp`` server expects; ``FMP_API_KEY``
# is accepted as an alias. The same value is synced into OpenBB MCP's
# ``user_settings.json`` as ``fmp_api_key`` so fundamental routes work.
# Keys load from ``.env`` on startup (see ``src/core/config.py`` and ``run_local.sh``).
# FMP_ACCESS_TOKEN=
# FMP_API_KEY=
# FMP Starter (or higher): setting FMP_ACCESS_TOKEN/FMP_API_KEY enables OpenBB
# FMP fundamental/estimate tools automatically. Set this false only to force
# free-tier behavior even when a key is configured.
# FINCENT_OPENBB_ALLOW_PAID_FMP_FUNDAMENTALS=false
# Optional paid Intrinio only: expose Intrinio-only OpenBB tools.
# FINCENT_OPENBB_ALLOW_INTRINIO=true
# INTRINIO_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# TAVILY_API_KEY=
