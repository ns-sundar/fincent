{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fincent accounts.json",
  "description": "Array of investment/cash accounts with their current holdings.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["account_id", "name", "type", "currency", "broker", "opened_date", "holdings"],
    "additionalProperties": true,
    "properties": {
      "account_id": {
        "type": "string",
        "minLength": 1,
        "description": "Unique account identifier (e.g. 'ACC-001')."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Human-readable account name."
      },
      "type": {
        "type": "string",
        "enum": ["stock", "bond", "cash"],
        "description": "Asset class of the account."
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "description": "ISO 4217 currency code (e.g. 'USD')."
      },
      "broker": {
        "type": "string",
        "minLength": 1,
        "description": "Brokerage or custodian name."
      },
      "opened_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Account opening date in YYYY-MM-DD format."
      },
      "holdings": {
        "type": "array",
        "minItems": 1,
        "description": "Current positions held in this account.",
        "items": {
          "type": "object",
          "required": ["ticker", "shares", "avg_cost", "current_price"],
          "additionalProperties": true,
          "properties": {
            "ticker": {
              "type": "string",
              "minLength": 1,
              "description": "Ticker symbol or fund identifier."
            },
            "description": {
              "type": "string",
              "description": "Optional long name / description of the holding."
            },
            "shares": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Number of shares (or units) held."
            },
            "avg_cost": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Average cost basis per share."
            },
            "current_price": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Most recent price per share."
            },
            "yield_pct": {
              "type": "number",
              "minimum": 0,
              "description": "Annualised yield percentage (bonds / money-market only)."
            },
            "duration_years": {
              "type": "number",
              "minimum": 0,
              "description": "Modified duration in years (bonds only)."
            }
          }
        }
      }
    }
  }
}
